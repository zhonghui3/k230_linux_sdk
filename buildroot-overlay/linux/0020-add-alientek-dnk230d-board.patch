From dcb85d9c4e9a3630618cbc5a91019fe9a211ce52 Mon Sep 17 00:00:00 2001
From: Alientek <support@alientek.com>
Date: Thu, 8 May 2026 10:00:00 +0800
Subject: [PATCH] add k230d-canmv-atk-dnk230d board (Alientek DNK230D)

diff --git a/arch/riscv/boot/dts/canaan/display-st7701-480x640.dtsi b/arch/riscv/boot/dts/canaan/display-st7701-480x640.dtsi
new file mode 100644
index 000000000000..111111111111
--- /dev/null
+++ b/arch/riscv/boot/dts/canaan/display-st7701-480x640.dtsi
@@ -0,0 +1,97 @@
+// SPDX-License-Identifier: GPL-2.0
+&vo {
+	vth_line = <10>;
+};
+
+&dsi {
+	ports {
+		port@1 {
+			reg = <1>;
+			dsi_out_st7701: endpoint {
+				remote-endpoint = <&st7701_in>;
+			};
+		};
+	};
+
+	lcd: panel@0 {
+		compatible = "canaan,universal";
+		reg = <0>;
+
+		panel-width-mm = <480>;
+		panel-height-mm = <640>;
+		panel-dsi-lane = <2>;
+
+		panel-init-sequence = [
+			39 00 06 ff 77 01 00 00 13
+			39 00 02 ef 08
+			39 00 06 ff 77 01 00 00 10
+			39 00 03 c0 63 00
+			39 00 03 c1 10 02
+			39 00 03 c2 31 02
+			39 00 02 cc 10
+			39 00 11 b0 c0 0c 92 0c 10 05 02 0d 07 21 04 53 11 6a 32 1f
+			39 00 11 b1 c0 87 cf 0c 10 06 00 03 08 1d 06 54 12 e6 ec 0f
+			39 00 06 ff 77 01 00 00 11
+			39 00 02 b0 5d
+			39 00 02 b1 62
+			39 00 02 b2 82
+			39 00 02 b3 80
+			39 00 02 b5 42
+			39 00 02 b7 85
+			39 00 02 b8 20
+			39 00 02 c0 09
+			39 00 02 c1 78
+			39 00 02 c2 78
+			39 00 02 d0 88
+			39 ff 02 ee 42
+			39 00 04 e0 00 00 02
+			39 00 0c e1 04 a0 06 a0 05 a0 07 a0 00 44 44
+			39 00 0d e2 00 00 33 33 01 a0 00 00 01 a0 00 00
+			39 00 05 e3 00 00 33 33
+			39 00 03 e4 44 44
+			39 00 11 e5 0c 30 a0 a0 0e 32 a0 a0 08 2c a0 a0 0a 2e a0 a0
+			39 00 05 e6 00 00 33 33
+			39 00 03 e7 44 44
+			39 00 11 e8 0d 31 a0 a0 0f 33 a0 a0 09 2d a0 a0 0b 2f a0 a0
+			39 00 08 eb 00 01 e4 e4 44 88 00
+			39 00 11 ed ff f5 47 6f 0b a1 a2 bf fb 2a 1a b0 f6 74 5f ff
+			39 00 07 ef 08 08 08 40 3f 64
+			39 00 06 ff 77 01 00 00 13
+			39 00 03 e8 00 0e
+			39 00 06 ff 77 01 00 00 00
+			39 ff 01 11
+			39 00 06 ff 77 01 00 00 13
+			39 ff 03 e8 00 0c
+			39 00 03 e8 00 00
+			39 00 06 ff 77 01 00 00 00
+			39 00 02 3a 50
+			39 ff 01 29
+		];
+
+		display-timings {
+			timing-0 {
+				clock-frequency = <32000000>;
+				hactive = <480>;
+				vactive = <640>;
+				hfront-porch = <80>;
+				hback-porch = <20>;
+				hsync-len = <20>;
+				vfront-porch = <180>;
+				vback-porch = <60>;
+				vsync-len = <10>;
+			};
+		};
+
+		ports {
+			#address-cells = <1>;
+			#size-cells = <0>;
+
+			port@0 {
+				reg = <0>;
+				st7701_in: endpoint {
+					remote-endpoint = <&dsi_out_st7701>;
+				};
+			};
+		};
+	};
+};
diff --git a/arch/riscv/boot/dts/canaan/k230d-canmv-atk-dnk230d.dts b/arch/riscv/boot/dts/canaan/k230d-canmv-atk-dnk230d.dts
new file mode 100644
index 000000000000..111111111111
--- /dev/null
+++ b/arch/riscv/boot/dts/canaan/k230d-canmv-atk-dnk230d.dts
@@ -0,0 +1,87 @@
+// SPDX-License-Identifier: GPL-2.0 OR MIT
+/*
+ * Copyright (C) 2024 Alientek
+ * Alientek DNK230D development board device tree
+ */
+
+#include "k230.dtsi"
+#include "display-st7701-480x640.dtsi"
+
+/ {
+	model = "Alientek DNK230D";
+	compatible = "alientek,dnk230d", "canaan,kendryte-k230";
+
+	aliases {
+		serial2 = &uart2;
+		mmc0 = &mmc_sd0;
+		mmc1 = &mmc_sd1;
+	};
+
+	chosen {
+		stdout-path = "serial0:115200n8";
+	};
+
+	ddr: memory@0 {
+		device_type = "memory";
+		reg = <0x0 0x0 0x0 0x8000000>;
+	};
+
+	sound {
+		status                      = "okay";
+		compatible                  = "canaan,k230-audio-inno";
+		canaan,model                = "K230_I2S_INNO";
+		canaan,k230-i2s-controller  = <&i2s>;
+		canaan,k230-audio-codec     = <&inno_codec>;
+	};
+
+	backlight {
+		compatible = "gpio-backlight";
+		gpios = <&gpio0_ports 5 GPIO_ACTIVE_HIGH>;
+		default-on;
+	};
+};
+
+&mmc_sd0 {
+	status = "okay";
+	cap-sd-highspeed;
+	rx_delay_line = <0x0d>;
+	tx_delay_line = <0xb0>;
+	sdhci-caps-mask = <0x2 0>;
+};
+
+&mmc_sd1 {
+	status = "okay";
+	no-1-8-v;
+	cap-sd-highspeed;
+	mshc_ctrl_r = <0x00>;
+};
+
+&uart0 {
+	status = "okay";
+};
+
+&uart2 {
+	status = "okay";
+};
+
+&i2c3 {
+	status = "okay";
+};
+
+&i2c4 {
+	status = "okay";
+};
+
+&usb0 {
+	status = "okay";
+};
+
+&usb1 {
+	dr_mode = "host";
+	status = "okay";
+};
+
+&lcd {
+	dsi_reset-gpios = <&gpio0_ports 3 GPIO_ACTIVE_HIGH>;
+	backlight_gpio-gpios = <&gpio0_ports 5 GPIO_ACTIVE_HIGH>;
+};
--
2.25.1
